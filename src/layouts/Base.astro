---
import { getRelativeLocaleUrl } from "astro:i18n";
import "../design-system/tokens.generated.css";
import "../design-system/style-props.generated.css";
import "../design-system/base.css";

interface Props {
  title: string;
  /** Páginas internas que nunca se indexan, ni siquiera al publicar. */
  noindex?: boolean;
  languageNav?: boolean;
}

const { title, noindex = false, languageNav = true } = Astro.props;
const locale = Astro.currentLocale ?? "es";
// Hasta publicar con el dominio definitivo la web no se indexa.
// Al publicar: PUBLIC_ALLOW_INDEXING=true en las variables de entorno de Vercel.
const indexable = !noindex && import.meta.env.PUBLIC_ALLOW_INDEXING === "true";
const locales = [
  { code: "es", label: "Español" },
  { code: "ca", label: "Català" },
  { code: "en", label: "English" },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="robots"
      content={indexable ? "index, follow" : "noindex, nofollow"}
    />
    <title>{title}</title>
  </head>
  <body>
    {languageNav && (
      <nav aria-label="Language">
        {locales.map(({ code, label }) => (
          <a
            href={getRelativeLocaleUrl(code)}
            lang={code}
            hreflang={code}
            aria-current={code === locale ? "true" : undefined}
          >
            {label}
          </a>
        ))}
      </nav>
    )}
    <main>
      <slot />
    </main>
  </body>
</html>
