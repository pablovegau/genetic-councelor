---
import { Font, getImage } from "astro:assets";
import photo from "../assets/mg-3199.webp";
import { contactEmail, linkedinUrl } from "../config/contact";
import { visits } from "../config/booking";
import { getCopy } from "../i18n";
import "../design-system/tokens.generated.css";
import "../design-system/style-props.generated.css";
import "../design-system/base.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import { locales } from "../i18n";

interface Props {
  title: string;
  description?: string;
  /** Páginas internas que nunca se indexan, ni siquiera al publicar. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const locale = Astro.currentLocale ?? "es";
// Hasta publicar con el dominio definitivo la web no se indexa.
// Al publicar: PUBLIC_ALLOW_INDEXING=true en las variables de entorno de Vercel.
const indexable = !noindex && import.meta.env.PUBLIC_ALLOW_INDEXING === "true";

// Canonical y versiones por idioma (hreflang). Las páginas del catálogo y la 404 no se traducen.
const { pathname } = Astro.url;
const translated =
  !pathname.startsWith("/design-system") && pathname !== "/404/";
const absolute = (path: string) => new URL(path, Astro.site).href;
const page = pathname.replace(/^\/(ca|en)(?=\/|$)/, "").replace(/^\/|\/$/g, "");
const alternates = locales.map(({ code }) => ({
  code,
  href: absolute(getRelativeLocaleUrl(code, page)),
}));

// Imagen para compartir: la foto principal de Sara recortada a 1200×630 (formato de Open Graph).
const share = await getImage({
  src: photo,
  width: 1200,
  height: 630,
  fit: "cover",
  position: "top",
  format: "jpeg",
  quality: 80,
});
const shareUrl = absolute(share.src);
const copy = getCopy(locale);
const ogLocales = { es: "es_ES", ca: "ca_ES", en: "en_GB" } as const;
const ogLocale = ogLocales[locale as keyof typeof ogLocales] ?? "es_ES";

// Datos estructurados: Sara (Person) y su servicio (ProfessionalService) con el precio de cada visita.
const siteName = copy.site.brand;
const visitOffers = [
  { name: copy.booking.first.name, price: visits.first.price },
  { name: copy.booking.followup.name, price: visits.followup.price },
];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": absolute("/#sara"),
      name: siteName,
      jobTitle: copy.site.jobTitle,
      url: absolute(getRelativeLocaleUrl(locale)),
      image: shareUrl,
      email: contactEmail,
      sameAs: [linkedinUrl],
      knowsLanguage: locales.map(({ code }) => code),
      address: {
        "@type": "PostalAddress",
        addressLocality: "Barcelona",
        addressCountry: "ES",
      },
    },
    {
      "@type": "ProfessionalService",
      "@id": absolute("/#servicio"),
      name: `${siteName} · ${copy.site.jobTitle}`,
      url: absolute(getRelativeLocaleUrl(locale)),
      description: copy.meta.description,
      image: shareUrl,
      provider: { "@id": absolute("/#sara") },
      areaServed: "ES",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Barcelona",
        addressCountry: "ES",
      },
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "customer service",
        email: contactEmail,
        availableLanguage: locales.map(({ code }) => code),
      },
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: copy.booking.visitsTitle,
        itemListElement: visitOffers.map(({ name, price }) => ({
          "@type": "Offer",
          itemOffered: { "@type": "Service", name },
          price,
          priceCurrency: "EUR",
          priceSpecification: {
            "@type": "PriceSpecification",
            price,
            priceCurrency: "EUR",
            valueAddedTaxIncluded: true,
          },
        })),
      },
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="robots"
      content={indexable ? "index, follow" : "noindex, nofollow"}
    />
    {translated && <link rel="canonical" href={absolute(pathname)} />}
    {translated &&
      alternates.map(({ code, href }) => (
        <link rel="alternate" hreflang={code} href={href} />
      ))}
    {translated && (
      <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    )}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {translated && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={siteName} />
        <meta property="og:title" content={title} />
        {description && (
          <meta property="og:description" content={description} />
        )}
        <meta property="og:url" content={absolute(pathname)} />
        <meta property="og:locale" content={ogLocale} />
        {Object.entries(ogLocales)
          .filter(([code]) => code !== locale)
          .map(([, value]) => (
            <meta property="og:locale:alternate" content={value} />
          ))}
        <meta property="og:image" content={shareUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={siteName} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        {description && (
          <meta name="twitter:description" content={description} />
        )}
        <meta name="twitter:image" content={shareUrl} />
        <meta name="twitter:image:alt" content={siteName} />
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      </>
    )}
    <Font cssVariable="--font-funnel-display" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-funnel-sans" preload={[{ subset: "latin" }]} />
    <script is:inline>
      // Esquema elegido por la persona: se aplica antes del primer pintado para que no parpadee.
      try {
        const saved = localStorage.getItem("scheme");
        if (saved === "light" || saved === "dark")
          document.documentElement.dataset.scheme = saved;
      } catch {
        // Sin almacenamiento (modo privado, bloqueado): se sigue el esquema del sistema.
      }
    </script>
  </head>
  <body class="site">
    <slot name="header" />
    <main>
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<style is:global>
  /* Astro registra cada fuente con un nombre único (p. ej. «Funnel Display-b0a0…») y lo expone en
     --font-funnel-*. Este puente conecta esas variables con los tokens de familia, que de otro modo
     apuntarían a un nombre que el navegador no conoce. Sin capa, para ganar a tokens.generated.css. */
  :root {
    --font-family-display: var(--font-funnel-display);
    --font-family-sans: var(--font-funnel-sans);
  }
</style>
