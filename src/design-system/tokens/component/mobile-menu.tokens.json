{
  "$description": "Tokens del menú móvil: panel lateral con cristal esmerilado. Solo alias.",
  "mobile-menu": {
    "bg": {
      "$type": "color",
      "$value": "{color.bg.overlay}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.default}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.surface}"
    },
    "blur": {
      "$type": "dimension",
      "$value": "{blur.md}"
    },
    "inset-top": {
      "$description": "Alto de la cabecera (relleno de la barra + botón de 40 px + relleno): el panel empieza donde acaba la cabecera, así el hueco bajo el botón es igual que el de encima.",
      "$type": "dimension",
      "$value": "{space.18}"
    },
    "inset-x": {
      "$type": "dimension",
      "$value": "{space.3}"
    },
    "inset-bottom": {
      "$type": "dimension",
      "$value": "{space.3}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{space.6}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "duration": {
      "$type": "duration",
      "$value": "{duration.normal}"
    },
    "easing": {
      "$type": "cubicBezier",
      "$value": "{easing.standard}"
    }
  }
}
