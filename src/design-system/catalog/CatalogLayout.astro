---
import Base from "../../layouts/Base.astro";
import { Flex, Text } from "../primitives";
import CatalogNav from "./CatalogNav.astro";
import { catalogGroups } from "./sections";

interface Props {
  group?: string;
  item?: string;
}

const { group: groupSlug, item: itemSlug } = Astro.props;
const group = catalogGroups.find((candidate) => candidate.slug === groupSlug);
const item = group?.items.find((candidate) => candidate.slug === itemSlug);

if (groupSlug && itemSlug && !item) {
  throw new Error(`La página ${groupSlug}/${itemSlug} no está en sections.ts`);
}

const title = item?.label ?? "Design system";
const description =
  item?.description ??
  "Catálogo interno. Tokens DTCG 2025.10, tema default, esquemas claro y oscuro. Los valores actuales son placeholders neutros.";
---

<Base
  title={item ? `${item.label} · Design system` : "Design system"}
  noindex
  languageNav={false}
>
  <div class="catalog">
    <CatalogNav currentPath={Astro.url.pathname} />
    <div class="catalog-main">
      <Flex as="header" direction="column" gap="3" className="catalog-header">
        {group && item && (
          <Text size="2" color="muted">
            {group.label} / {item.label}
          </Text>
        )}
        <Text as="h1" size="8" weight="bold" leading="tight">
          {title}
        </Text>
        <Text color="muted">{description}</Text>
      </Flex>
      <div class="catalog-content" data-catalog-content>
        <slot />
      </div>
    </div>
  </div>

  <script>
    document
      .querySelectorAll<HTMLButtonElement>("[data-set-scheme]")
      .forEach((button) => {
        button.addEventListener("click", () => {
          const scheme = button.dataset.setScheme;
          if (scheme === "system")
            delete document.documentElement.dataset.scheme;
          else document.documentElement.dataset.scheme = scheme;
        });
      });
  </script>
</Base>

<style>
  .catalog {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .catalog-main {
    min-inline-size: 0;
    max-inline-size: 64rem;
  }

  .catalog-content {
    padding: var(--space-6) var(--space-6) var(--space-24);
  }

  .catalog-main :global(.catalog-header) {
    padding: var(--space-8) var(--space-6) var(--space-6);
    border-block-end: var(--border-width-1) solid var(--color-border-default);
  }

  @media (min-width: 48rem) {
    .catalog {
      grid-template-columns: 16rem minmax(0, 1fr);
      align-items: start;
    }

    .catalog-content {
      padding-inline: var(--space-10);
      padding-block-start: var(--space-10);
    }

    .catalog-main :global(.catalog-header) {
      padding-inline: var(--space-10);
      padding-block-start: var(--space-12);
    }
  }
</style>
