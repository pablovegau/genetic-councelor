---
import { catalogGroups, catalogHref } from "./sections";

interface Props {
  currentPath: string;
}

const normalize = (path: string) => path.replace(/\/+$/, "");
const current = normalize(Astro.props.currentPath);
const isCurrent = (href: string) => normalize(href) === current;
---

<nav class="catalog-nav" aria-label="Catálogo del design system">
  <a
    class="overview"
    href="/design-system/"
    aria-current={isCurrent("/design-system/") ? "page" : undefined}
  >
    Overview
  </a>
  {catalogGroups.map((group) => (
    <details open>
      <summary>{group.label}</summary>
      <ul>
        {group.items.map((item) => (
          <li>
            <a
              href={catalogHref(group, item)}
              aria-current={
                isCurrent(catalogHref(group, item)) ? "page" : undefined
              }
            >
              {item.label}
            </a>
          </li>
        ))}
        {group.pending?.map((label) => (
          <li class="pending">
            <span>{label}</span>
            <small>pendiente</small>
          </li>
        ))}
      </ul>
    </details>
  ))}
  <div class="scheme" role="group" aria-label="Esquema de color">
    <span>Esquema</span>
    <button type="button" data-set-scheme="system">
      Sistema
    </button>
    <button type="button" data-set-scheme="light">
      Claro
    </button>
    <button type="button" data-set-scheme="dark">
      Oscuro
    </button>
  </div>
</nav>

<style>
  .catalog-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    border-bottom: var(--border-width-1) solid var(--color-border-default);
    font-size: var(--font-size-2);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-control);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: "";
    inline-size: var(--space-2);
    block-size: var(--space-2);
    border-inline-end: var(--border-width-2) solid currentColor;
    border-block-end: var(--border-width-2) solid currentColor;
    transform: rotate(-45deg);
  }

  details[open] > summary::after {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    summary::after {
      transition: transform var(--motion-duration-interaction)
        var(--motion-easing-default);
    }
  }

  summary:hover {
    background-color: var(--color-bg-subtle);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-1) 0 var(--space-2) var(--space-3);
    list-style: none;
  }

  a,
  .pending {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-control);
  }

  a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .overview {
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-default);
  }

  a:hover {
    background-color: var(--color-bg-subtle);
    color: var(--color-text-default);
  }

  a[aria-current] {
    background-color: var(--color-bg-subtle);
    color: var(--color-text-default);
    font-weight: var(--font-weight-semibold);
  }

  .pending {
    color: var(--color-text-muted);
  }

  small {
    font-size: var(--font-size-1);
  }

  .scheme {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
    padding: var(--space-3);
    border-block-start: var(--border-width-1) solid var(--color-border-default);
    color: var(--color-text-muted);
    font-size: var(--font-size-1);
  }

  .scheme span {
    inline-size: 100%;
  }

  summary:focus-visible,
  a:focus-visible {
    outline: var(--border-width-2) solid var(--color-focus-ring);
    outline-offset: calc(var(--border-width-2) * -1);
  }

  @media (min-width: 48rem) {
    .catalog-nav {
      position: sticky;
      inset-block-start: 0;
      block-size: 100dvh;
      overflow-y: auto;
      border-bottom: 0;
      border-inline-end: var(--border-width-1) solid var(--color-border-default);
      padding-block: var(--space-6);
    }
  }
</style>

<script>
  // En pantallas estrechas solo queda abierto el grupo de la página actual, para que el menú no
  // ocupe la pantalla.
  if (window.matchMedia("(max-width: 47.99rem)").matches) {
    document.querySelectorAll(".catalog-nav details").forEach((group) => {
      if (!group.querySelector("[aria-current]")) group.removeAttribute("open");
    });
  }
</script>
