---
import CatalogLayout from "./CatalogLayout.astro";
import CodeLine from "./CodeLine.astro";
import CopyButton from "./CopyButton.astro";
import DocPage from "./DocPage.astro";
import DocSection from "./DocSection.astro";
import Notes from "./Notes.astro";
import PropsTable from "./PropsTable.astro";
import type { PropRow } from "./prop-docs";
import { Text } from "../primitives";

interface Props {
  /** Slug de la página en sections.ts. */
  item: string;
  /** Texto de la sección Uso. */
  intro: string;
  importLine: string;
  usage: string;
  /** Nombre del componente en la tabla de props. */
  component: string;
  rows: PropRow[];
  demoDescription?: string;
  tokens?: [string, string][];
  notes?: string[];
}

const {
  item,
  intro,
  importLine,
  usage,
  component,
  rows,
  demoDescription = "El componente con datos de ejemplo.",
  tokens = [],
  notes = [],
} = Astro.props;
---

<CatalogLayout group="components" item={item}>
  <DocPage>
    <DocSection id="usage" title="Uso" description={intro}>
      <CodeLine code={importLine} label="Copiar la importación" />
      <div class="code">
        <pre><code>{usage}</code></pre>
        <CopyButton value={usage} label="Copiar el ejemplo" />
      </div>
    </DocSection>

    <DocSection id="demo" title="Prueba" description={demoDescription}>
      <div class="stage">
        <slot />
      </div>
    </DocSection>

    <DocSection id="props" title="Props">
      <PropsTable component={component} rows={rows} />
    </DocSection>

    {tokens.length > 0 && (
      <DocSection
        id="tokens"
        title="Tokens"
        description="Tokens de componente: alias de los semánticos y primitivos, así que el esquema oscuro llega solo."
      >
        <ul class="tokens">
          {tokens.map(([name, description]) => (
            <li>
              <code>{name}</code>
              <Text as="span" size="2" color="muted">
                {description}
              </Text>
              <CopyButton
                value={`var(${name})`}
                label={`Copiar var(${name})`}
              />
            </li>
          ))}
        </ul>
      </DocSection>
    )}

    {notes.length > 0 && (
      <DocSection id="a11y" title="Accesibilidad y comportamiento">
        <Notes>
          {notes.map((note) => (
            <li set:html={note} />
          ))}
        </Notes>
      </DocSection>
    )}
  </DocPage>
</CatalogLayout>

<style>
  .code {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: var(--border-width-1) solid var(--color-border-default);
    border-radius: var(--radius-surface);
    background-color: var(--color-bg-surface);
  }

  .code pre {
    min-inline-size: 0;
    margin: 0;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  .code code {
    font-size: var(--font-size-2);
  }

  .stage {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-block-size: var(--space-16);
    padding: var(--space-6);
    overflow: hidden;
    border: var(--border-width-1) solid var(--color-border-default);
    border-radius: var(--radius-surface);
    background-color: var(--color-bg-page);
  }

  .tokens {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tokens li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-2) var(--space-3);
    border: var(--border-width-1) solid var(--color-border-default);
    border-radius: var(--radius-control);
  }

  .tokens code {
    font-size: var(--font-size-2);
  }

  .tokens li :global(button) {
    margin-inline-start: auto;
  }
</style>
