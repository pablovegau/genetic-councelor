---
import CopyButton from "./CopyButton.astro";
import { tokenReference, tokenVariable } from "./tokens";

interface Props {
  /** Ruta completa del token, por ejemplo `space.4`. */
  token: string;
  /** Líneas de detalle bajo el nombre (valor, alias, equivalente en píxeles…). */
  details?: string[];
}

const { token, details = [] } = Astro.props;
---

<div class="card">
  <div class="preview">
    <slot />
  </div>
  <div class="info">
    <code class="name">{token}</code>
    <code class="variable">{tokenVariable(token)}</code>
    {details.map((line) => (
      <span class="detail">{line}</span>
    ))}
  </div>
  <CopyButton value={tokenReference(token)} />
</div>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    border: var(--border-width-1) solid var(--color-border-default);
    border-radius: var(--radius-surface);
    background-color: var(--color-bg-surface);
  }

  .preview {
    display: flex;
    align-items: center;
    min-block-size: var(--space-24);
    padding: var(--space-3);
    overflow: hidden;
    border: var(--border-width-1) solid var(--color-border-default);
    border-radius: var(--radius-control);
    background-color: var(--color-bg-subtle);
  }

  .info {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-1);
    min-inline-size: 0;
  }

  code {
    overflow-wrap: anywhere;
  }

  .name {
    font-size: var(--font-size-2);
    font-weight: var(--font-weight-semibold);
  }

  .variable,
  .detail {
    color: var(--color-text-muted);
    font-size: var(--font-size-1);
  }

  .detail {
    font-family: inherit;
  }

  .card :global(.copy) {
    align-self: flex-start;
  }
</style>
