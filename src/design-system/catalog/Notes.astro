---
// Lista de notas (accesibilidad, buenas prácticas) de la página de un componente.
---

<ul class="notes">
  <slot />
</ul>

<style>
  .notes {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding-inline-start: var(--space-5);
    font-size: var(--font-size-3);
    line-height: var(--font-line-height-relaxed);
  }

  .notes :global(code) {
    font-size: var(--font-size-2);
  }
</style>
