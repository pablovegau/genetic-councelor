---
import CodeLine from "./CodeLine.astro";

interface Props {
  title: string;
  code: string;
}

const { title, code } = Astro.props;
---

<div class="example">
  <h3>{title}</h3>
  <div class="stage">
    <slot />
  </div>
  <CodeLine code={code} label="Copiar el ejemplo" />
</div>

<style>
  .example {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  h3 {
    margin: 0;
    font-size: var(--font-size-3);
    font-weight: var(--font-weight-semibold);
  }

  .stage {
    padding: var(--space-6);
    overflow: hidden;
    border: var(--border-width-1) solid var(--color-border-default);
    border-radius: var(--radius-surface);
    background-color: var(--color-bg-subtle);
  }
</style>
