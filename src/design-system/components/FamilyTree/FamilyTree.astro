---
import {
  carrierDotRadius,
  circleRadius,
  squareSize,
  treeLines,
  treeNodes,
  treeViewBox,
  type TreeSymbol,
} from "./family-tree-geometry";

interface Props {
  /** Nombre accesible del dibujo. */
  ariaLabel: string;
  /** Frase bajo el dibujo cuando no hay ningún símbolo activo. */
  caption: string;
  /** Qué es cada símbolo: su nombre accesible y la explicación que sale bajo el árbol. */
  symbols: Record<TreeSymbol, { label: string; text: string }>;
}

const { ariaLabel, caption, symbols } = Astro.props;
---

<div class="tree-wrap" data-family-tree>
  <svg
    class="tree"
    viewBox={treeViewBox}
    role="group"
    aria-label={ariaLabel}
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {treeLines.map((d) => (
      <path class="line" pathLength="1" d={d} />
    ))}
    {treeNodes.map((node, i) => {
      const attrs = {
        class: node.fill ? `node ${node.fill}` : "node",
        style: `--i:${i}`,
        "data-text": symbols[node.symbol].text,
        "data-label": symbols[node.symbol].label,
      };
      return node.shape === "square" ? (
        <rect
          {...attrs}
          x={node.x}
          y={node.y}
          width={squareSize}
          height={squareSize}
        />
      ) : node.shape === "circle" ? (
        <circle {...attrs} cx={node.cx} cy={node.cy} r={circleRadius} />
      ) : (
        <g {...attrs}>
          <circle class="s3" cx={node.cx} cy={node.cy} r={circleRadius} />
          <circle class="f3" cx={node.cx} cy={node.cy} r={carrierDotRadius} />
        </g>
      );
    })}
  </svg>
  <p class="tree-caption" aria-live="polite" data-default={caption}>
    {caption}
  </p>
</div>

<script>
  // Los símbolos explican qué son al pasar el ratón, enfocar con teclado o tocar.
  document
    .querySelectorAll<HTMLElement>("[data-family-tree]")
    .forEach((root) => {
      const caption = root.querySelector<HTMLElement>(".tree-caption");
      const show = (node: SVGElement | null) => {
        if (caption)
          caption.textContent =
            node?.dataset.text ?? caption.dataset.default ?? "";
      };
      root.querySelectorAll<SVGElement>(".tree .node").forEach((node) => {
        node.setAttribute("tabindex", "0");
        node.setAttribute("role", "button");
        node.setAttribute("aria-label", node.dataset.label ?? "");
        node.addEventListener("mouseenter", () => show(node));
        node.addEventListener("mouseleave", () => show(null));
        node.addEventListener("focus", () => show(node));
        node.addEventListener("blur", () => show(null));
        node.addEventListener("click", () => show(node));
      });
    });
</script>

<style>
  .tree-wrap {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    inline-size: 100%;
    max-inline-size: 21rem;
    justify-self: center;
  }

  @media (min-width: 48rem) {
    .tree-wrap {
      max-inline-size: 36rem;
    }
  }

  .tree {
    inline-size: 100%;
    color: var(--color-text-default);
  }

  .tree-caption {
    min-block-size: 3em;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    text-align: center;
  }

  .node {
    cursor: pointer;
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.15s;
  }

  .f1 {
    fill: var(--color-danger-bg);
    stroke: var(--color-danger-bg);
  }

  .f2 {
    fill: var(--color-accent-bg);
    stroke: var(--color-accent-bg);
  }

  .f3 {
    fill: var(--color-action-bg);
    stroke: var(--color-action-bg);
  }

  .s3 {
    fill: none;
    stroke: var(--color-action-bg);
  }

  /* Los símbolos sin color se rellenan con el fondo: al crecer con el hover tapan los trazos de detrás. */
  .node:not(.f1):not(.f2):not(.f3),
  .node .s3 {
    fill: var(--color-bg-page);
  }

  .node:hover,
  .node:focus-visible {
    transform: scale(1.18);
    outline: none;
  }

  .node:focus-visible {
    filter: drop-shadow(0 0 3px currentcolor);
  }

  /* Se dibuja una vez al cargar: las líneas se trazan y los símbolos aparecen uno a uno. */
  @media (prefers-reduced-motion: no-preference) {
    .line {
      stroke-dasharray: 1;
      animation: tree-draw 1.4s ease-out both;
    }

    .node {
      animation: tree-pop 0.5s ease-out both;
      animation-delay: calc(0.15s + var(--i) * 0.11s);
    }
  }

  @keyframes tree-draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  @keyframes tree-pop {
    from {
      opacity: 0;
      scale: 0.5;
    }
  }
</style>
