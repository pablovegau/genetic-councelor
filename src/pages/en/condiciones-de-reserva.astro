---
import BookingTerms from "../../components/legal/BookingTerms.astro";
import LegalPage from "../../components/legal/LegalPage.astro";
import Site from "../../layouts/Site.astro";
import { getCopy } from "../../i18n";

const { footer, legal } = getCopy(Astro.currentLocale);
const title = footer.legalLinks[3];
---

<Site title={title} description={legal.descriptions[3]}>
  <LegalPage title={title}>
    <BookingTerms />
  </LegalPage>
</Site>
