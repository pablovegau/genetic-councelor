---
import CatalogLayout from "../../../design-system/catalog/CatalogLayout.astro";
import TokenRow from "../../../design-system/catalog/TokenRow.astro";
import {
  primitiveLookup,
  semantic,
  shape,
  tokensOf,
} from "../../../design-system/catalog/token-data";
import {
  describeValue,
  tokenVariable,
} from "../../../design-system/catalog/tokens";

const primitives = tokensOf(shape, "radius.");
const aliases = semantic.filter(({ path }) => path.startsWith("radius."));
---

<CatalogLayout group="tokens" item="radii">
  <div class="page">
    <section class="block" aria-labelledby="radius-primitives">
      <h2 id="radius-primitives">Primitivos</h2>
      <div class="list">
        {primitives.map(({ path, value }) => (
          <TokenRow
            token={path}
            details={describeValue(value, primitiveLookup)}
          >
            <div
              class="box"
              style={`border-radius: var(${tokenVariable(path)})`}
              aria-hidden="true"
            />
          </TokenRow>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="radius-semantic">
      <h2 id="radius-semantic">Semánticos</h2>
      <p>Los componentes usan estos alias, no los primitivos.</p>
      <div class="list">
        {aliases.map(({ path, value }) => (
          <TokenRow
            token={path}
            details={describeValue(value, primitiveLookup)}
          >
            <div
              class="box"
              style={`border-radius: var(${tokenVariable(path)})`}
              aria-hidden="true"
            />
          </TokenRow>
        ))}
      </div>
    </section>
  </div>
</CatalogLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  h2,
  p {
    margin: 0;
  }

  h2 {
    font-size: var(--font-size-6);
    font-weight: var(--font-weight-semibold);
  }

  p {
    color: var(--color-text-muted);
    font-size: var(--font-size-2);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .box {
    inline-size: var(--space-16);
    block-size: var(--space-16);
    border: var(--border-width-2) solid var(--color-border-strong);
    background-color: var(--color-bg-subtle);
  }
</style>
