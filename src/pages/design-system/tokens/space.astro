---
import CatalogLayout from "../../../design-system/catalog/CatalogLayout.astro";
import TokenCard from "../../../design-system/catalog/TokenCard.astro";
import {
  primitiveLookup,
  space,
} from "../../../design-system/catalog/token-data";
import {
  describeValue,
  flattenTokens,
  tokenVariable,
} from "../../../design-system/catalog/tokens";

const tokens = flattenTokens(space);
---

<CatalogLayout group="tokens" item="space">
  <div class="grid">
    {tokens.map(({ path, value }) => (
      <TokenCard token={path} details={describeValue(value, primitiveLookup)}>
        <div
          class="bar"
          style={`inline-size: var(${tokenVariable(path)})`}
          aria-hidden="true"
        />
      </TokenCard>
    ))}
  </div>
</CatalogLayout>

<style>
  .grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(
      auto-fill,
      minmax(var(--card-min, 13rem), 1fr)
    );
  }

  .bar {
    block-size: var(--space-3);
    border: var(--border-width-1) solid var(--color-border-strong);
    background-color: var(--color-action-bg);
  }
</style>
