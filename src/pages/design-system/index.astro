---
import CatalogLayout from "../../design-system/catalog/CatalogLayout.astro";
import { Flex, Text } from "../../design-system/primitives";
import {
  catalogGroups,
  catalogHref,
} from "../../design-system/catalog/sections";
---

<CatalogLayout>
  <Flex direction="column" gap="10">
    {catalogGroups.map((group) => (
      <Flex
        as="section"
        direction="column"
        gap="4"
        aria-labelledby={`group-${group.slug}`}
      >
        <Flex direction="column" gap="1">
          <Text as="h2" id={`group-${group.slug}`} size="6" weight="semibold">
            {group.label}
          </Text>
          <Text color="muted">{group.description}</Text>
        </Flex>
        <div class="cards">
          {group.items.map((item) => (
            <a class="card" href={catalogHref(group, item)}>
              <Text as="span" weight="semibold">
                {item.label}
              </Text>
              <Text as="span" size="2" color="muted">
                {item.description}
              </Text>
            </a>
          ))}
          {group.pending?.map((label) => (
            <div class="card pending">
              <Text as="span" weight="semibold">
                {label}
              </Text>
              <Text as="span" size="2" color="muted">
                Pendiente: se creará con el primer componente.
              </Text>
            </div>
          ))}
        </div>
      </Flex>
    ))}
  </Flex>
</CatalogLayout>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-4);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border: var(--border-width-1) solid var(--color-border-default);
    border-radius: var(--radius-surface);
    color: inherit;
    text-decoration: none;
  }

  a.card:hover {
    background-color: var(--color-bg-subtle);
    border-color: var(--color-border-strong);
  }

  .pending {
    border-style: dashed;
  }

  a.card:focus-visible {
    outline: var(--border-width-2) solid var(--color-focus-ring);
    outline-offset: var(--border-width-2);
  }
</style>
