---
import ComponentPage from "../../../design-system/catalog/ComponentPage.astro";
import type { PropRow } from "../../../design-system/catalog/prop-docs";
import FamilyTree from "../../../design-system/components/FamilyTree/FamilyTree.astro";

const usage =
  '<FamilyTree ariaLabel="…" caption="…" symbols={{ man: { label, text }, … }} generation="Generación" />';

const rows: PropRow[] = [
  {
    name: "ariaLabel",
    type: "string",
    default: "—",
    description: "Nombre accesible del dibujo.",
  },
  {
    name: "caption",
    type: "string",
    default: "—",
    description: "Frase bajo el dibujo cuando no hay ningún símbolo activo.",
  },
  {
    name: "generation",
    type: "string",
    default: "—",
    description:
      "Palabra «Generación»: cada símbolo dice su número romano en el texto interactivo.",
  },
  {
    name: "symbols",
    type: 'Record<"man" | "woman" | "manCarrier" | "womanCarrier" | "manAffected" | "womanAffected" | "manOther" | "womanOther" | "proband", { label; text }>',
    default: "—",
    description: "Nombre accesible y explicación de cada símbolo.",
  },
];
---

<ComponentPage
  item="family-tree"
  intro={
    "La ilustración del hero: tres generaciones según las guías de la NSGC, con el hombre a la izquierda de cada pareja. Una misma condición lleva siempre el mismo color. Es un componente Astro con un script mínimo (sin isla de React)."
  }
  importLine={
    'import FamilyTree from "design-system/components/FamilyTree/FamilyTree.astro";'
  }
  usage={usage}
  component="FamilyTree"
  rows={rows}
  tokens={[]}
  notes={[
    "Cada símbolo se enfoca con el teclado, es un botón con nombre accesible y explica qué es bajo el dibujo.",
    "Con <code>prefers-reduced-motion</code> no se anima el trazado.",
    "Se mantiene como Astro (no React) para no hidratar una isla: el único JavaScript es un script de unas líneas.",
  ]}
>
  <FamilyTree
    ariaLabel="Árbol familiar de ejemplo"
    caption="Toca un símbolo."
    generation="Generación"
    symbols={{
      man: {
        label: "Hombre no afecto",
        text: "Un cuadrado vacío es un hombre no afecto.",
      },
      woman: {
        label: "Mujer no afecta",
        text: "Un círculo vacío es una mujer no afecta.",
      },
      manCarrier: {
        label: "Hombre portador",
        text: "Un punto: porta la variante sin síntomas.",
      },
      womanCarrier: {
        label: "Mujer portadora",
        text: "Un punto: porta la variante sin síntomas.",
      },
      manAffected: {
        label: "Hombre con la condición",
        text: "Relleno: tiene la condición.",
      },
      womanAffected: {
        label: "Mujer con la condición",
        text: "Relleno: tiene la condición.",
      },
      manOther: {
        label: "Hombre con otra condición",
        text: "Otro color: otra condición.",
      },
      womanOther: {
        label: "Mujer con otra condición",
        text: "Otro color: otra condición.",
      },
      proband: {
        label: "Persona que consulta",
        text: "La flecha señala al probando.",
      },
    }}
  />
</ComponentPage>
