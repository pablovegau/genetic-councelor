---
import BookingTermsCa from "./BookingTermsCa.astro";
import BookingTermsEn from "./BookingTermsEn.astro";
import BookingTermsEs from "./BookingTermsEs.astro";

const locale = Astro.currentLocale ?? "es";
---

{locale === "ca" ? (
  <BookingTermsCa />
) : locale === "en" ? (
  <BookingTermsEn />
) : (
  <BookingTermsEs />
)}
