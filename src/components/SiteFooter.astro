---
import { getRelativeLocaleUrl } from "astro:i18n";
import { contactEmail, linkedinUrl } from "../config/contact";
import { Footer } from "../design-system/components";
import { getCopy } from "../i18n";

const locale = Astro.currentLocale ?? "es";
const { site, footer } = getCopy(locale);
const home = getRelativeLocaleUrl(locale);
const about = getRelativeLocaleUrl(locale, "sobre-mi");
const book = getRelativeLocaleUrl(locale, "reservar");
const columns = [
  {
    title: footer.pages,
    links: [
      { label: footer.home, href: home },
      { label: site.nav.about, href: about },
      { label: site.book, href: book },
      { label: site.nav.contact, href: "#contacto" },
    ],
  },
  {
    title: footer.legal,
    links: footer.legalLinks.map((label) => ({ label, href: "#contacto" })),
  },
  {
    title: footer.contact,
    links: [
      { label: contactEmail, href: `mailto:${contactEmail}` },
      { label: "LinkedIn", href: linkedinUrl },
    ],
  },
];
---

<Footer
  id="contacto"
  brand={site.brand}
  tagline={footer.tagline}
  columns={columns}
  base={footer.copyright}
/>
