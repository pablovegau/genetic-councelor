---
import portrait from "../assets/mg-3199.webp";
import {
  Portrait,
  PressList,
  PublicationList,
  Section,
  Split,
} from "../design-system/components";
import { Text } from "../design-system/primitives";
import { getCopy } from "../i18n";
import publications from "../data/publications.json";
import notes from "../data/publication-notes.json";
import press from "../data/press.json";
import {
  formatAuthors,
  orderPublications,
  type PublicationNotes,
} from "../lib/publications";
import { pressGroup, type PressEntry } from "../lib/press";
import styles from "./AboutPage.module.css";

const { site, about, aboutPage } = getCopy(Astro.currentLocale);
const locale = (Astro.currentLocale ?? "es") as "es" | "ca" | "en";
const publicationNotes = notes as PublicationNotes;
const items = orderPublications(publications, publicationNotes).map(
  (publication) => ({
    id: publication.id,
    title: publication.title,
    journal: publication.journal,
    year: publication.year,
    authors: formatAuthors(publication.authors),
    summary: publicationNotes[publication.id]?.summary[locale],
    url: publication.url,
  })
);
const dateFormat = new Intl.DateTimeFormat(locale, { dateStyle: "medium" });
const pressItems = (group: PressEntry["group"]) =>
  pressGroup(press as PressEntry[], group).map((entry) => ({
    id: entry.id,
    outlet: entry.outlet,
    date: entry.date ? dateFormat.format(new Date(entry.date)) : undefined,
    title: entry.title,
    lang: entry.lang,
    url: entry.url,
    label: entry.kind ? aboutPage.pressKinds[entry.kind] : undefined,
  }));
// Símbolo de cada dato clave, como en el árbol genealógico de la portada.
const factMarkers = [
  ["circle", "action"],
  ["square", "accent"],
  ["circle", "danger"],
] as const;
const count = (template: string, n: number) =>
  template.replace("{count}", String(n));
---

<Section pad="start">
  <Split ratio={1.25} gap="wide">
    <div class={styles.portrait}>
      <Portrait
        src={portrait.src}
        width={portrait.width}
        height={portrait.height}
        alt={about.imageAlt}
      />
    </div>
    <div class={styles.intro}>
      <Text as="h1" variant="heading-2" className={styles.title}>
        {site.brand}
      </Text>
      <Text variant="text-lg" color="muted">
        {aboutPage.lead}
      </Text>
      <ul class={styles.facts}>
        {aboutPage.facts.map((fact, i) => (
          <li>
            <span
              class={styles.marker}
              data-shape={factMarkers[i]![0]}
              data-tone={factMarkers[i]![1]}
              aria-hidden="true"
            />
            <Text>{fact}</Text>
          </li>
        ))}
      </ul>
    </div>
  </Split>
</Section>

<Section tone="violet" band="action">
  <Split gap="wide" align="start">
    <div class={styles.block}>
      <Text as="h2" variant="heading-3">
        {aboutPage.careerTitle}
      </Text>
      <ol class={styles.timeline}>
        {aboutPage.career.map(({ when, role, place, detail, kind }) => (
          <li data-kind={kind}>
            <Text size="2" color="muted">
              {when}
            </Text>
            <Text as="h3" variant="heading-5">
              {role}
            </Text>
            <Text>{place}</Text>
            {detail && (
              <Text size="2" color="muted">
                {detail}
              </Text>
            )}
          </li>
        ))}
      </ol>
    </div>
    <div class={styles.block}>
      <Text as="h2" variant="heading-3">
        {aboutPage.educationTitle}
      </Text>
      <ul class={styles.education}>
        {aboutPage.education.map((degree) => (
          <li>
            <Text>{degree}</Text>
          </li>
        ))}
      </ul>
    </div>
  </Split>
</Section>

<Section id="prensa" tone="orange" band="accent">
  <div class={styles.press}>
    <Text as="h2" variant="heading-3">
      {aboutPage.pressTitle}
    </Text>
    <div class={styles.block}>
      <Text as="h3" variant="heading-4">
        {aboutPage.pressGroups.telomeres.title}
      </Text>
      <Text color="muted" className={styles.lead}>
        {aboutPage.pressGroups.telomeres.text}
      </Text>
      <PressList
        items={pressItems("telomeres")}
        newTabLabel={aboutPage.newTab}
      />
    </div>
    <div class={styles.block}>
      <Text as="h3" variant="heading-4">
        {aboutPage.pressGroups.other.title}
      </Text>
      <PressList items={pressItems("other")} newTabLabel={aboutPage.newTab} />
    </div>
  </div>
</Section>

<Section id="publicaciones">
  <div class={styles.block}>
    <Text as="h2" variant="heading-3">
      {aboutPage.publicationsTitle}
    </Text>
    <Text variant="text-lg" color="muted">
      {`${aboutPage.publicationsLead} ${count(aboutPage.total, items.length)}`}
    </Text>
    <PublicationList
      items={items}
      moreLabel={count(aboutPage.more, Math.max(items.length - 5, 0))}
      newTabLabel={aboutPage.newTab}
    />
  </div>
</Section>
