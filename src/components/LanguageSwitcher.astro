---
import { getRelativeLocaleUrl } from "astro:i18n";
import { LanguageSwitch } from "../design-system/components";
import { getCopy, locales } from "../i18n";

const locale = Astro.currentLocale ?? "es";
const { site } = getCopy(locale);
const items = locales.map(({ code }) => ({
  code,
  href: getRelativeLocaleUrl(code),
}));
---

<LanguageSwitch label={site.languages} items={items} current={locale} />
