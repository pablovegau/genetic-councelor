---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCopy, locales } from "../i18n";

const locale = Astro.currentLocale ?? "es";
const { site } = getCopy(locale);
const home = getRelativeLocaleUrl(locale);
const nav = [
  { label: site.nav.about, href: "#sobre-mi" },
  { label: site.nav.contact, href: "#contacto" },
];
---

<header class="top">
  <div class="sec-in top-in">
    <a class="brand" href={home}>
      {site.brand}
    </a>
    <nav class="nav-inline" aria-label={site.mainNav}>
      {nav.map(({ label, href }) => (
        <a href={href}>{label}</a>
      ))}
    </nav>
    <div class="langs" role="group" aria-label={site.languages}>
      {locales.map(({ code }) => (
        <a
          href={getRelativeLocaleUrl(code)}
          lang={code}
          hreflang={code}
          aria-current={code === locale ? "true" : undefined}
        >
          {code.toUpperCase()}
        </a>
      ))}
    </div>
    <div class="top-actions">
      <a class="cta cta-sm" href="#cita">
        {site.book}
      </a>
      <button
        class="icon-btn scheme-btn"
        type="button"
        data-scheme-toggle
        data-to-dark={site.toDark}
        data-to-light={site.toLight}
        aria-label={site.toDark}
      >
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"></path>
        </svg>
      </button>
      <button
        class="icon-btn menu-btn"
        type="button"
        popovertarget="menu"
        aria-label={site.openMenu}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 8h16M4 16h16"></path>
        </svg>
      </button>
    </div>
    <nav id="menu" popover class="nav-pop" aria-label={site.mainNav}>
      <button
        type="button"
        popovertarget="menu"
        popovertargetaction="hide"
        aria-label={site.closeMenu}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
      {nav.map(({ label, href }) => (
        <a href={href}>{label}</a>
      ))}
      <a class="cta" href="#cita">
        {site.book}
      </a>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const media = matchMedia("(prefers-color-scheme: dark)");
  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-scheme-toggle]"
  );
  const effective = () =>
    root.dataset.scheme ?? (media.matches ? "dark" : "light");
  const sync = () => {
    if (!toggle) return;
    toggle.setAttribute(
      "aria-label",
      (effective() === "dark"
        ? toggle.dataset.toLight
        : toggle.dataset.toDark) ?? ""
    );
  };
  toggle?.addEventListener("click", () => {
    const next = effective() === "dark" ? "light" : "dark";
    root.dataset.scheme = next;
    try {
      localStorage.setItem("scheme", next);
    } catch {
      // Sin almacenamiento: el cambio vale solo para esta visita.
    }
    sync();
  });
  media.addEventListener("change", sync);
  sync();

  // Al elegir un enlace del menú móvil, el panel se cierra.
  document
    .querySelectorAll<HTMLElement>("#menu a")
    .forEach((link) =>
      link.addEventListener("click", () =>
        document.querySelector<HTMLElement>("#menu")?.hidePopover()
      )
    );
</script>
