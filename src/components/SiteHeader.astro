---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Button, MobileMenu } from "../design-system/components";
import { getCopy } from "../i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import SchemeToggle from "./SchemeToggle.astro";

const locale = Astro.currentLocale ?? "es";
const { site } = getCopy(locale);
const home = getRelativeLocaleUrl(locale);
const nav = [
  { label: site.nav.about, href: "#sobre-mi" },
  { label: site.nav.contact, href: "#contacto" },
];
---

<header class="top">
  <div class="sec-in top-in">
    <a class="brand" href={home}>
      {site.brand}
    </a>
    <nav class="nav-inline" aria-label={site.mainNav}>
      {nav.map(({ label, href }) => (
        <a href={href}>{label}</a>
      ))}
    </nav>
    <div class="bar-langs">
      <LanguageSwitcher />
    </div>
    <div class="top-actions">
      <Button className="cta cta-sm" size="sm" href="#cita">
        {site.book}
      </Button>
      <SchemeToggle toDark={site.toDark} toLight={site.toLight} />
      <div class="menu-btn">
        <MobileMenu
          client:idle
          label={site.mainNav}
          openLabel={site.openMenu}
          closeLabel={site.closeMenu}
          links={nav}
        >
          <LanguageSwitcher />
          <Button href="#cita">{site.book}</Button>
        </MobileMenu>
      </div>
    </div>
  </div>
</header>
