---
import { getRelativeLocaleUrl } from "astro:i18n";
import { socialLinks } from "../config/contact";
import {
  Button,
  Container,
  Icon,
  Link,
  MobileMenu,
  BrandMark,
  Wordmark,
} from "../design-system/components";
import SchemeToggle from "../design-system/components/SchemeToggle/SchemeToggle.astro";
import { getCopy } from "../i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const locale = Astro.currentLocale ?? "es";
const { site } = getCopy(locale);
const home = getRelativeLocaleUrl(locale);
const book = getRelativeLocaleUrl(locale, "reservar");
const nav = [
  { label: site.nav.about, href: getRelativeLocaleUrl(locale, "sobre-mi") },
  { label: site.nav.blog, href: getRelativeLocaleUrl(locale, "blog") },
  { label: site.nav.contact, href: getRelativeLocaleUrl(locale, "contacto") },
];
---

<header>
  <Container pad="bar">
    <div class="bar">
      <div class="brand">
        <Wordmark fit mark href={home}>
          <BrandMark />
          {site.brand}
        </Wordmark>
      </div>
      <nav class="nav" aria-label={site.mainNav}>
        {nav.map(({ label, href }) => (
          <Link variant="nav" href={href}>
            {label}
          </Link>
        ))}
      </nav>
      <div class="langs">
        <LanguageSwitcher />
      </div>
      <ul class="social">
        {socialLinks.map(({ name, href, icon }) => (
          <li>
            <a
              {href}
              aria-label={name}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name={icon} />
            </a>
          </li>
        ))}
      </ul>
      <div class="actions">
        <div class="book">
          <Button size="sm" href={book}>
            {site.book}
          </Button>
        </div>
        <SchemeToggle toDark={site.toDark} toLight={site.toLight} />
        <MobileMenu
          client:idle
          label={site.mainNav}
          openLabel={site.openMenu}
          closeLabel={site.closeMenu}
          links={nav}
        >
          <LanguageSwitcher />
          <Button href={book}>{site.book}</Button>
        </MobileMenu>
      </div>
    </div>
  </Container>
</header>

<style>
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .brand {
    margin-inline-end: auto;
  }

  .nav,
  .langs,
  .social,
  .book {
    display: none;
  }

  .actions {
    display: flex;
    align-items: center;
  }

  @media (min-width: 30rem) {
    .bar {
      gap: var(--space-4);
    }

    .actions {
      gap: var(--space-1);
    }
  }

  /* Escritorio: los enlaces, el idioma y el botón van en la barra; el menú lateral desaparece. */
  @media (min-width: 48rem) {
    /* Sin margen automático en la marca: el menú se centra entre la marca y el selector de idioma. */
    .brand {
      margin-inline-end: 0;
    }

    .nav {
      display: flex;
      gap: var(--space-8);
      margin-inline: auto;
    }

    .social {
      display: flex;
      gap: var(--space-1);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .social a {
      display: grid;
      place-items: center;
      inline-size: 2.5rem;
      block-size: 2.5rem;
      border-radius: 50%;
      color: inherit;
      font-size: 1.125rem;
    }

    .social a:hover {
      color: var(--color-action-bg);
    }

    .langs {
      display: block;
    }

    .book {
      display: inline-flex;
    }
  }
</style>
