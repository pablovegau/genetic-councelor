---
import { getCopy } from "../i18n";
import {
  carrierDotRadius,
  circleRadius,
  squareSize,
  treeLines,
  treeNodes,
  treeViewBox,
} from "./family-tree-geometry";

const { tree } = getCopy(Astro.currentLocale);
---

<div class="tree-wrap">
  <svg
    class="tree"
    viewBox={treeViewBox}
    role="group"
    aria-label={tree.ariaLabel}
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {treeLines.map((d) => (
      <path class="line" pathLength="1" d={d} />
    ))}
    {treeNodes.map((node, i) => {
      const attrs = {
        class: node.fill ? `node ${node.fill}` : "node",
        style: `--i:${i}`,
        "data-text": tree[node.symbol].text,
        "data-label": tree[node.symbol].label,
      };
      return node.shape === "square" ? (
        <rect
          {...attrs}
          x={node.x}
          y={node.y}
          width={squareSize}
          height={squareSize}
        />
      ) : node.shape === "circle" ? (
        <circle {...attrs} cx={node.cx} cy={node.cy} r={circleRadius} />
      ) : (
        <g {...attrs}>
          <circle class="s3" cx={node.cx} cy={node.cy} r={circleRadius} />
          <circle class="f3" cx={node.cx} cy={node.cy} r={carrierDotRadius} />
        </g>
      );
    })}
  </svg>
  <p class="tree-caption" aria-live="polite" data-default={tree.caption}>
    {tree.caption}
  </p>
</div>

<script>
  // Los símbolos explican qué son al pasar el ratón, enfocar con teclado o tocar.
  const caption = document.querySelector<HTMLElement>(".tree-caption");
  const nodes = document.querySelectorAll<SVGElement>(".tree .node");
  const show = (node: SVGElement | null) => {
    if (caption)
      caption.textContent = node?.dataset.text ?? caption.dataset.default ?? "";
  };
  nodes.forEach((node) => {
    node.setAttribute("tabindex", "0");
    node.setAttribute("role", "button");
    node.setAttribute("aria-label", node.dataset.label ?? "");
    node.addEventListener("mouseenter", () => show(node));
    node.addEventListener("mouseleave", () => show(null));
    node.addEventListener("focus", () => show(node));
    node.addEventListener("blur", () => show(null));
    node.addEventListener("click", () => show(node));
  });
</script>
