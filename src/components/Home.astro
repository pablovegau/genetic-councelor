---
import avatar from "../assets/mg-3149.webp";
import portrait from "../assets/mg-3199.webp";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCopy } from "../i18n";
import {
  Button,
  Byline,
  Link,
  MarkerList,
  PriceCard,
  Portrait,
  Section,
  Split,
  Steps,
} from "../design-system/components";
import FamilyTree from "../design-system/components/FamilyTree/FamilyTree.astro";
import { Text } from "../design-system/primitives";
import { visits } from "../config/booking";
import styles from "./Home.module.css";

const copy = getCopy(Astro.currentLocale);
const book = getRelativeLocaleUrl(Astro.currentLocale ?? "es", "reservar");
const termsHref = getRelativeLocaleUrl(
  Astro.currentLocale ?? "es",
  "condiciones-de-reserva"
);
const aboutHref = getRelativeLocaleUrl(Astro.currentLocale ?? "es", "sobre-mi");
const euro = new Intl.NumberFormat(Astro.currentLocale ?? "es", {
  style: "currency",
  currency: "EUR",
  maximumFractionDigits: 0,
});
const price = euro.format(visits.first.price);
const { site, hero, situations, process, about, closing, tree, booking } = copy;
// Cada tarjeta lleva a /reservar/ con su visita elegida (con las reservas activas abre su calendario).
const visitCards = [
  { ...booking.first, visit: visits.first },
  { ...booking.followup, visit: visits.followup },
].map(({ name, description, visit }) => ({
  name,
  description,
  price: euro.format(visit.price),
  href: `${book}?visita=${visit.slug}`,
}));

const markers = [
  { marker: "circle", tone: "danger" },
  { marker: "square", tone: "accent" },
  { marker: "circle", tone: "action" },
  { marker: "square", tone: "danger" },
] as const;
const situationItems = situations.items.map(({ title, text }, i) => ({
  title,
  text,
  href: book,
  ...markers[i]!,
}));

// Un icono por paso de la primera visita (el segundo trazo, de acento, con el color de la franja).
const stepIcons = [
  {
    paths: [
      "M7 3.5h10a2 2 0 0 1 2 2v13.5a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5.5a2 2 0 0 1 2-2z",
      "M9 3.5h6V6H9z",
    ],
    accent: ["M8.5 11.5h7M8.5 15h4.5"],
  },
  {
    paths: [
      "M3.5 6.5a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H9.5l-3.5 3v-3h-.5a2 2 0 0 1-2-2z",
    ],
    accent: [
      "M19.5 9.5h.5a1.5 1.5 0 0 1 1.5 1.5v5a1.5 1.5 0 0 1-1.5 1.5H20v2.5l-3-2.5h-3.5",
    ],
  },
  {
    paths: [
      "M17 10.5a6.5 6.5 0 1 1-13 0a6.5 6.5 0 0 1 13 0z",
      "M20.5 20.5l-5.4-5.4",
    ],
    accent: ["M7.5 10.5l2.2 2.2 3.8-4.4"],
  },
  {
    paths: [
      "M5.7 5h12.6a2.2 2.2 0 0 1 2.2 2.2v11.1a2.2 2.2 0 0 1-2.2 2.2H5.7a2.2 2.2 0 0 1-2.2-2.2V7.2A2.2 2.2 0 0 1 5.7 5z",
      "M8 3v4M16 3v4M3.5 10h17",
    ],
    accent: ["M8.8 15.2l2.4 2.4 4.2-4.6"],
  },
];
const steps = process.steps.map(({ when, title, text, key, value }, i) => ({
  when,
  title,
  text,
  detailLabel: key,
  detail: value,
  icon: stepIcons[i]!,
}));
---

<div id="inicio">
  <Section pad="start">
    <Split ratio={1.05} gap="wide" className={styles.hero}>
      <div class={styles.heroCopy}>
        <Text as="h1" variant="heading-1" className={styles.heroTitle}>
          {hero.title}
        </Text>
        <Text variant="text" color="muted" className={styles.heroText}>
          {hero.text}
        </Text>
        <div class={styles.heroActions}>
          <div class={styles.heroCta}>
            <Button href={book}>{site.book}</Button>
            <Text variant="text-sm" color="muted" className={styles.heroPrice}>
              {hero.price.replace("{price}", price)}
            </Text>
          </div>
          <div class={styles.heroByline}>
            <Byline avatar={avatar} name={site.brand} description={hero.role} />
          </div>
        </div>
        <Text
          as="small"
          variant="text-sm"
          color="muted"
          className={styles.heroNote}
        >
          {hero.confidential}
        </Text>
      </div>
      <div class={styles.heroTree}>
        <FamilyTree
          ariaLabel={tree.ariaLabel}
          caption={tree.caption}
          generation={tree.generation}
          symbols={tree}
        />
      </div>
    </Split>
  </Section>

  <Section id="sobre-mi" tone="violet" band="action">
    <Split ratio={1.25} gap="wide">
      <Portrait
        src={portrait.src}
        width={portrait.width}
        height={portrait.height}
        alt={about.imageAlt}
        loading="lazy"
      />
      <div class={styles.copy}>
        <Text as="h2" variant="heading-2" className={styles.title}>
          {site.brand}
        </Text>
        {about.text.map((paragraph) => (
          <Text variant="text" color="muted">
            {paragraph}
          </Text>
        ))}
        <Link href={aboutHref}>{about.link}</Link>
      </div>
    </Split>
  </Section>

  <Section>
    <div class={styles.stack}>
      <Text as="h2" variant="heading-2" className={styles.title}>
        {situations.title}
      </Text>
      <Text variant="text" color="muted" className={styles.lead}>
        {situations.lead}
      </Text>
      <MarkerList items={situationItems} />
    </div>
  </Section>

  <Section id="primera-visita" tone="orange" band="accent">
    <div class={styles.stack}>
      <Text as="h2" variant="heading-2" className={styles.title}>
        {process.title}
      </Text>
      <Text variant="text" color="muted" className={styles.lead}>
        {process.lead}
      </Text>
      <Steps items={steps} />
    </div>
  </Section>

  <Section id="visitas">
    <div class={styles.stack}>
      <Text as="h2" variant="heading-2" className={styles.title}>
        {booking.visitsTitle}
      </Text>
      <div class={styles.cards}>
        {visitCards.map(({ name, description, price, href }) => (
          <PriceCard name={name} price={price} description={description}>
            <Button href={href}>{booking.choose}</Button>
          </PriceCard>
        ))}
      </div>
      <Text size="2" color="muted">
        {`${booking.terms.text} `}
        <Link href={termsHref}>{booking.terms.link}</Link>
      </Text>
    </div>
  </Section>

  <Section id="cita" band="action">
    <Split ratio={1.6}>
      <div class={styles.closing}>
        <Text as="h2" variant="heading-2" className={styles.title}>
          {closing.title}
        </Text>
        <Text variant="text" color="muted" className={styles.lead}>
          {closing.lead}
        </Text>
      </div>
      <div class={styles.closingAction}>
        <Button href={book}>{site.book}</Button>
      </div>
    </Split>
  </Section>
</div>
