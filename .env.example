# Variables públicas de la web. Se incrustan al compilar: al cambiarlas en Vercel hay que redesplegar.
# En local, copia este fichero a .env.local (no se sube al repositorio).

# Reservas con Cal.com. Solo "true" las activa. Ausente o cualquier otro valor: /reservar/ avisa de que
# las reservas se abrirán pronto y la web no enlaza a Cal.com ni carga nada suyo.
PUBLIC_CAL_BOOKING_ENABLED=

# Datos del titular para el aviso legal y la política de privacidad. No van en el repositorio (es público).
PUBLIC_LEGAL_NIF=
PUBLIC_LEGAL_ADDRESS=

# Quitar el noindex. Solo "true" deja que los buscadores indexen la web; con "true" el build exige
# PUBLIC_LEGAL_NIF y PUBLIC_LEGAL_ADDRESS.
PUBLIC_ALLOW_INDEXING=
